{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidesigners.art/schemas/image-generate.schema.json",
  "title": "AIDesigner Image Generate Input",
  "type": "object",
  "required": ["prompt"],
  "properties": {
    "prompt": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "modelId": { "type": "string" },
    "size": { "enum": ["auto", "21:9", "16:9", "3:2", "4:3", "1:1", "3:4", "2:3", "9:16"] },
    "preset": { "enum": ["default", "2k", "4k"] },
    "count": { "type": "integer", "minimum": 1, "maximum": 8 },
    "referenceImageUrls": { "type": "array", "items": { "type": "string", "format": "uri" }, "maxItems": 4 }
  },
  "additionalProperties": false
}
