{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidesigners.art/schemas/video-remake-plan.schema.json",
  "title": "AIDesigner Public Video Remake Plan",
  "type": "object",
  "required": ["schemaVersion", "sourceDurationSec", "units", "frames", "evidence", "claims", "requiresConfirmation"],
  "properties": {
    "schemaVersion": { "const": "aidesigner-workflow/v1" },
    "sourceDurationSec": { "type": "number", "exclusiveMinimum": 0 },
    "requiresConfirmation": { "const": true },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string" },
          "sourceTimestampSec": { "type": "number", "minimum": 0 },
          "sourceAssetId": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "startSec", "endSec", "evidenceIds", "intent"],
        "properties": {
          "id": { "type": "string" },
          "startSec": { "type": "number", "minimum": 0 },
          "endSec": { "type": "number", "exclusiveMinimum": 0 },
          "evidenceIds": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "intent": { "type": "string" },
          "dialogue": { "type": "string" },
          "productQuantity": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "unitId", "sourceTimestampSec", "evidenceIds", "shotPurpose", "referenceRoles"],
        "properties": {
          "id": { "type": "string" },
          "unitId": { "type": "string" },
          "sourceTimestampSec": { "type": "number", "minimum": 0 },
          "evidenceIds": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "shotPurpose": { "type": "string" },
          "referenceRoles": { "type": "array", "items": { "enum": ["source_video", "source_frame_sheet", "product", "person", "scene", "style"] } }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "evidenceId"],
        "properties": { "text": { "type": "string" }, "evidenceId": { "type": "string" } },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
